diff --git a/plugins/gtkui/playlist/playlistrenderer.c b/plugins/gtkui/playlist/playlistrenderer.c
index ead374e..fd717df 100644
--- a/plugins/gtkui/playlist/playlistrenderer.c
+++ b/plugins/gtkui/playlist/playlistrenderer.c
@@ -35,6 +35,196 @@
 
 extern DB_functions_t *deadbeef;
 
+#define SENTINEL_NO_ART   ((GdkPixbuf *)0x1)
+#define SENTINEL_PENDING  ((GdkPixbuf *)0x2)
+#define PLAYLIST_THUMB_CACHE_MAX 1000
+
+typedef struct playlist_thumb_node_s {
+    char *key;
+    GdkPixbuf *thumb;
+    struct playlist_thumb_node_s *prev;
+    struct playlist_thumb_node_s *next;
+} playlist_thumb_node_t;
+
+typedef struct {
+    GHashTable *hash;
+    playlist_thumb_node_t *head;
+    playlist_thumb_node_t *tail;
+    int count;
+    int max_count;
+} playlist_thumb_cache_t;
+
+static playlist_thumb_cache_t playlist_thumb_cache = { 0 };
+
+static void
+_playlist_thumb_node_free (playlist_thumb_node_t *node) {
+    if (node->key) {
+        free (node->key);
+        node->key = NULL;
+    }
+    if (node->thumb && node->thumb != SENTINEL_NO_ART && node->thumb != SENTINEL_PENDING) {
+        g_object_unref (node->thumb);
+        node->thumb = NULL;
+    }
+    free (node);
+}
+
+static void
+_playlist_thumb_move_to_head (playlist_thumb_cache_t *cache, playlist_thumb_node_t *node) {
+    if (cache->head == node) {
+        return;
+    }
+    if (node->prev) {
+        node->prev->next = node->next;
+    }
+    if (node->next) {
+        node->next->prev = node->prev;
+    }
+    if (cache->tail == node) {
+        cache->tail = node->prev;
+    }
+    node->prev = NULL;
+    node->next = cache->head;
+    if (cache->head) {
+        cache->head->prev = node;
+    }
+    cache->head = node;
+    if (!cache->tail) {
+        cache->tail = node;
+    }
+}
+
+static playlist_thumb_node_t *
+_playlist_thumb_cache_get (playlist_thumb_cache_t *cache, const char *key) {
+    if (!cache || !cache->hash || !key) {
+        return NULL;
+    }
+    playlist_thumb_node_t *node = g_hash_table_lookup (cache->hash, key);
+    if (node) {
+        _playlist_thumb_move_to_head (cache, node);
+    }
+    return node;
+}
+
+static void
+_playlist_thumb_cache_put (playlist_thumb_cache_t *cache, const char *key, GdkPixbuf *thumb) {
+    if (!cache || !cache->hash || !key) {
+        if (thumb && thumb != SENTINEL_NO_ART && thumb != SENTINEL_PENDING) {
+            g_object_unref (thumb);
+        }
+        return;
+    }
+
+    playlist_thumb_node_t *node = g_hash_table_lookup (cache->hash, key);
+    if (node) {
+        if (node->thumb != thumb) {
+            if (node->thumb && node->thumb != SENTINEL_NO_ART && node->thumb != SENTINEL_PENDING) {
+                g_object_unref (node->thumb);
+            }
+            node->thumb = thumb;
+        }
+        _playlist_thumb_move_to_head (cache, node);
+        return;
+    }
+
+    if (cache->count >= cache->max_count && cache->tail) {
+        playlist_thumb_node_t *evict = cache->tail;
+        g_hash_table_remove (cache->hash, evict->key);
+        if (evict->prev) {
+            evict->prev->next = NULL;
+            cache->tail = evict->prev;
+        }
+        else {
+            cache->head = cache->tail = NULL;
+        }
+        _playlist_thumb_node_free (evict);
+        cache->count--;
+    }
+
+    node = calloc (1, sizeof (playlist_thumb_node_t));
+    node->key = strdup (key);
+    node->thumb = thumb;
+    g_hash_table_insert (cache->hash, node->key, node);
+    _playlist_thumb_move_to_head (cache, node);
+    cache->count++;
+}
+
+static void
+_playlist_thumb_cache_clear (playlist_thumb_cache_t *cache) {
+    if (!cache) {
+        return;
+    }
+    playlist_thumb_node_t *node = cache->head;
+    while (node) {
+        playlist_thumb_node_t *next = node->next;
+        _playlist_thumb_node_free (node);
+        node = next;
+    }
+    cache->head = cache->tail = NULL;
+    cache->count = 0;
+    if (cache->hash) {
+        g_hash_table_remove_all (cache->hash);
+    }
+}
+
+static void
+_playlist_thumb_cache_init_if_needed (void) {
+    if (playlist_thumb_cache.hash == NULL) {
+        playlist_thumb_cache.hash = g_hash_table_new (g_str_hash, g_str_equal);
+        playlist_thumb_cache.max_count = PLAYLIST_THUMB_CACHE_MAX;
+    }
+}
+
+void
+pl_common_clear_thumb_cache (void) {
+    _playlist_thumb_cache_clear (&playlist_thumb_cache);
+}
+
+static GdkPixbuf *
+_playlist_scale_thumb (GdkPixbuf *image, int avail_w, int avail_h) {
+    if (!image || avail_w <= 0 || avail_h <= 0) {
+        return NULL;
+    }
+    int pw = gdk_pixbuf_get_width (image);
+    int ph = gdk_pixbuf_get_height (image);
+    if (pw <= 0 || ph <= 0) {
+        return NULL;
+    }
+    double scale = min ((double)avail_w / pw, (double)avail_h / ph);
+    int draw_w = (int)(pw * scale);
+    int draw_h = (int)(ph * scale);
+    if (draw_w < 1) draw_w = 1;
+    if (draw_h < 1) draw_h = 1;
+    return gdk_pixbuf_scale_simple (image, draw_w, draw_h, GDK_INTERP_BILINEAR);
+}
+
+static void
+_playlist_draw_thumb (cairo_t *cr, GdkPixbuf *thumb, int x, int y, int width, int height, int align, int pad_x, int pad_y) {
+    int tw = gdk_pixbuf_get_width (thumb);
+    int th = gdk_pixbuf_get_height (thumb);
+    int draw_y = y + (height - th) / 2;
+    int draw_x;
+    if (align == 1) {
+        draw_x = x + width - pad_x - tw;
+    }
+    else if (align == 2) {
+        draw_x = x + (width - tw) / 2;
+    }
+    else {
+        draw_x = x + pad_x;
+    }
+
+    cairo_save (cr);
+    cairo_rectangle (cr, x, y, width, height);
+    cairo_clip (cr);
+
+    gdk_cairo_set_source_pixbuf (cr, thumb, draw_x, draw_y);
+    cairo_rectangle (cr, draw_x, draw_y, tw, th);
+    cairo_fill (cr);
+
+    cairo_restore (cr);
+}
+
